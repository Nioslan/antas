{
  "expo": {
    "name": "Finanzas Personales",
    "slug": "finanzas-personales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "finanzas-personales",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finanzas.personales"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.finanzas.personales"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/95204b8e-edf0-4b6e-a264-33229eda2f0b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E24B3C"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95204b8e-edf0-4b6e-a264-33229eda2f0b"
      }
    },
    "owner": "antas"
  }
}
